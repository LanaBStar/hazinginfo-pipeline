# Copy to .env and fill in real values. Never commit .env. Code must never print, log, or
# echo the *value* of any variable below - only its name (see lib/r2.py).

# --- Cloudflare R2 (02-archive, 03-normalize, 04-extract, 06-publish: sole write path) ---
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_NAME=hazinginfo-archive

# --- Neon Postgres (06-publish: rebuilt catalog, never authoritative) ---
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Cloudflare (05-review: Pages + Worker + Access login) ---
CLOUDFLARE_ACCOUNT_ID=changeme
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ACCESS_AUD=changeme

# --- Review Worker's own narrowly-scoped R2 credentials (reviews/ prefix only) ---
REVIEW_R2_ACCESS_KEY_ID=changeme
REVIEW_R2_SECRET_ACCESS_KEY=changeme

# --- Legacy system (migration/: one-time backfill, read-only, never written to) ---
OLD_R2_ENDPOINT_URL=https://<old-account-id>.r2.cloudflarestorage.com
OLD_R2_ACCESS_KEY_ID=changeme
OLD_R2_SECRET_ACCESS_KEY=changeme
OLD_R2_BUCKET_NAME=changeme
OLD_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
