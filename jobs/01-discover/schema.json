{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazinginfo.org/schemas/jobs/01-discover/candidates.schema.json",
  "title": "candidates.json",
  "description": "01-discover agent output: one file per batch, proposing CHTR URLs for operator confirmation. Never edits schools.csv directly.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "batch": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unitid": {"type": "string"},
          "proposed_url": {"type": "string", "format": "uri"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_quote": {"type": "string"}
        },
        "required": ["unitid", "proposed_url", "confidence", "evidence_quote"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "batch", "candidates"],
  "additionalProperties": false
}
