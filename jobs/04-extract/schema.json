{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazinginfo.org/schemas/jobs/04-extract/incidents.schema.json",
  "title": "incidents.json (v2 — v3.0 pipeline)",
  "description": "04-extract agent output. See DATABASE_SCHEMA.md's Staging_incidents/Staging_organizations. Every raw field is captured verbatim; every normalized field is the AI's own interpretation of that raw text. No page-anchored quotes and no offsets -- validate.py only checks schema conformance. Fields are exactly those the Act defines plus the data dictionary's staging fields — do not add hazing-type taxonomy, sanction severity, location, is_aggravated, or date_reported.",
  "$defs": {
    "date": {"type": ["string", "null"], "format": "date"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "alcohol_drugs_enum": {"enum": ["Yes", "No", "Not specified", "Unable to determine - Unclear reporting"]},
    "determination_status_enum": {"enum": ["Pending", "Determined hazing", "Dismissed", "Not specified"]},
    "date_precision_enum": {"enum": ["Year", "Day", "Academic year", "Academic term", "Month", "Unknown"]},
    "academic_term_enum": {"anyOf": [{"enum": ["Fall", "Spring", "Summer", "Winter"]}, {"type": "null"}]},
    "date_instance": {
      "type": "object",
      "properties": {
        "start_raw": {"type": ["string", "null"]},
        "start_normalized": {"$ref": "#/$defs/date"},
        "start_precision": {"$ref": "#/$defs/date_precision_enum"},
        "start_year": {"type": ["integer", "null"]},
        "start_month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "start_academic_term": {"$ref": "#/$defs/academic_term_enum"},
        "end_raw": {"type": ["string", "null"]},
        "end_normalized": {"$ref": "#/$defs/date"},
        "end_precision": {"$ref": "#/$defs/date_precision_enum"},
        "end_year": {"type": ["integer", "null"]},
        "end_month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "end_academic_term": {"$ref": "#/$defs/academic_term_enum"}
      },
      "required": [
        "start_raw", "start_normalized", "start_precision", "start_year", "start_month", "start_academic_term",
        "end_raw", "end_normalized", "end_precision", "end_year", "end_month", "end_academic_term"
      ],
      "additionalProperties": false
    },
    "organization_type_enum": {
      "anyOf": [
        {
          "enum": [
            "Social fraternity or sorority",
            "Service or professional fraternity or sorority",
            "Varsity athletic team",
            "Club sport",
            "Intramural or recreation sports team",
            "Honor society",
            "Academic club",
            "Performing arts organization",
            "Marching band",
            "ROTC or other military organization",
            "Social club",
            "Faith-based organization",
            "Culturally-based / identity-based organization",
            "Student government or other student leadership organization",
            "Community service organization",
            "Political organization or social action group",
            "Campus media organization",
            "Other type of organization"
          ]
        },
        {"type": "null"}
      ]
    },
    "flag_type_enum": {
      "enum": [
        "Legally required field missing",
        "Unable to derive value",
        "Alcohol/drugs review needed",
        "Determination unclear",
        "Low extraction confidence",
        "Unrecognized date term",
        "Unable to determine organization type"
      ]
    },
    "institutional_recognition_status_enum": {
      "enum": ["Recognized", "Unrecognized/Underground", "Formerly Recognized - Lost Recognition", "Unknown/Not Stated"]
    },
    "membership_gender_composition_enum": {
      "enum": ["All-male", "All-female", "Mixed/Co-ed", "Unknown/Not stated"]
    },
    "flag": {
      "type": "object",
      "properties": {
        "flag_type": {"$ref": "#/$defs/flag_type_enum"},
        "field_name": {"type": "string"},
        "note": {"type": ["string", "null"]}
      },
      "required": ["flag_type", "field_name", "note"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": 2},
    "is_chtr": {"type": "boolean"},
    "document": {
      "type": "object",
      "properties": {
        "reporting_period_start": {"$ref": "#/$defs/date"},
        "reporting_period_end": {"$ref": "#/$defs/date"},
        "publication_date": {"$ref": "#/$defs/date"},
        "zero_incidents_statement": {"type": ["string", "null"]}
      },
      "required": [
        "reporting_period_start",
        "reporting_period_end",
        "publication_date",
        "zero_incidents_statement"
      ],
      "additionalProperties": false
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "organization_name_raw": {"type": ["string", "null"]},
          "organization_name_normalized": {"type": ["string", "null"]},
          "organization_type": {"$ref": "#/$defs/organization_type_enum"},
          "membership_gender_composition": {"$ref": "#/$defs/membership_gender_composition_enum"},
          "institutional_recognition_status": {"$ref": "#/$defs/institutional_recognition_status_enum"},
          "description_raw": {"type": ["string", "null"]},
          "findings_raw": {"type": ["string", "null"]},
          "sanctions_raw": {"type": ["string", "null"]},
          "alcohol_involved": {"$ref": "#/$defs/alcohol_drugs_enum"},
          "drugs_involved": {"$ref": "#/$defs/alcohol_drugs_enum"},
          "determination_status": {"$ref": "#/$defs/determination_status_enum"},
          "dates": {
            "type": "object",
            "properties": {
              "investigation_start_date_raw": {"type": ["string", "null"]},
              "investigation_start_date": {"$ref": "#/$defs/date"},
              "investigation_end_date_raw": {"type": ["string", "null"]},
              "investigation_end_date": {"$ref": "#/$defs/date"},
              "notice_date_raw": {"type": ["string", "null"]},
              "notice_date": {"$ref": "#/$defs/date"}
            },
            "required": [
              "investigation_start_date_raw", "investigation_start_date",
              "investigation_end_date_raw", "investigation_end_date",
              "notice_date_raw", "notice_date"
            ],
            "additionalProperties": false
          },
          "incident_dates": {
            "type": "array",
            "items": {"$ref": "#/$defs/date_instance"},
            "minItems": 1
          },
          "extraction_confidence": {"$ref": "#/$defs/confidence"},
          "flags": {
            "type": "array",
            "items": {"$ref": "#/$defs/flag"}
          }
        },
        "required": [
          "organization_name_raw",
          "organization_name_normalized",
          "organization_type",
          "membership_gender_composition",
          "institutional_recognition_status",
          "description_raw",
          "findings_raw",
          "sanctions_raw",
          "alcohol_involved",
          "drugs_involved",
          "determination_status",
          "dates",
          "incident_dates",
          "extraction_confidence",
          "flags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "is_chtr", "document", "incidents"],
  "additionalProperties": false
}
