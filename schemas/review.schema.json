{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazinginfo.org/schemas/review.schema.json",
  "title": "review.json (v2 — v3.0 pipeline)",
  "description": "Human review decision, written synchronously at decision time via the review Worker's ingest.py. No tier, no escalation, no second_review -- every incident and organization proposal gets exactly one reviewer decision. corrections is a list, one entry per changed field (matching Staging_incident_corrections' one-row-per-field grain), not a dotted-path dict.",
  "$defs": {
    "correction_type_enum": {"enum": ["Minor cleanup", "Extraction error"]},
    "correction_entry": {
      "type": "object",
      "properties": {
        "field_name": {"type": "string"},
        "original_value": {"type": ["string", "null"]},
        "corrected_value": {"type": "string"},
        "correction_type": {
          "type": "array",
          "items": {"$ref": "#/$defs/correction_type_enum"},
          "minItems": 1
        }
      },
      "required": ["field_name", "original_value", "corrected_value", "correction_type"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"const": 2},
    "extraction_ref": {
      "type": "object",
      "properties": {
        "file_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "incident_index": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "null means this review is of the whole document, not one incidents[] entry -- the only case this applies to is a genuine zero-incident report (document.zero_incidents_statement), which has no incidents[] to index."
        }
      },
      "required": ["file_hash", "incident_index"],
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "corrected"]
    },
    "rejection_reason": {
      "type": ["string", "null"],
      "enum": ["not_hazing", "duplicate", "segmentation_error", "extraction_error", null]
    },
    "corrections": {
      "type": "array",
      "items": {"$ref": "#/$defs/correction_entry"}
    },
    "organization_review": {
      "type": ["object", "null"],
      "description": "Independent of decision -- the incident and its proposed organization can each be approved/rejected/corrected without waiting on the other. null means this screen's reviewer didn't touch the organization decision.",
      "properties": {
        "decision": {"type": "string", "enum": ["approved", "rejected", "corrected"]},
        "corrected_organization_type": {"type": ["string", "null"]},
        "corrected_membership_gender_composition": {"type": ["string", "null"]}
      },
      "required": ["decision", "corrected_organization_type", "corrected_membership_gender_composition"],
      "additionalProperties": false
    },
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "required": [
    "schema_version",
    "extraction_ref",
    "decision",
    "rejection_reason",
    "corrections",
    "organization_review",
    "reviewer",
    "reviewed_at"
  ],
  "additionalProperties": false
}
