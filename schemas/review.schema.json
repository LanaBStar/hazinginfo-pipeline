{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazinginfo.org/schemas/review.schema.json",
  "title": "review.json",
  "description": "Human review decision, written synchronously at decision time via the review Worker's ingest.py. Per IMPLEMENTATION_PLAN.md §10.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "extraction_ref": {
      "type": "object",
      "properties": {
        "file_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "incident_index": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "null means this review is of the whole document, not one incidents[] entry -- the only case this applies to is a 'fast'-tier zero-incident report (validate.py's document.tier), which has no incidents[] to index."
        }
      },
      "required": ["file_hash", "incident_index"],
      "additionalProperties": false
    },
    "tier": {"type": "string", "enum": ["fast", "standard", "flagged"]},
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "corrected", "escalated"],
      "description": "escalated: a single reviewer looked and could not decide -- resolved later by a second_review, the same mechanism flagged-tier dual review already uses. Never itself a terminal decision (rebuild.py only ever publishes approved/corrected)."
    },
    "rejection_reason": {
      "type": ["string", "null"],
      "enum": ["not_hazing", "duplicate", "segmentation_error", "extraction_error", null]
    },
    "corrections": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "string"}
    },
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "second_review": {
      "type": ["object", "null"],
      "properties": {
        "decision": {"type": "string", "enum": ["approved", "rejected", "corrected"]},
        "rejection_reason": {
          "type": ["string", "null"],
          "enum": ["not_hazing", "duplicate", "segmentation_error", "extraction_error", null]
        },
        "corrections": {
          "type": ["object", "null"],
          "additionalProperties": {"type": "string"}
        },
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["decision", "rejection_reason", "corrections", "reviewer", "reviewed_at"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "extraction_ref",
    "tier",
    "decision",
    "rejection_reason",
    "corrections",
    "reviewer",
    "reviewed_at",
    "second_review"
  ],
  "additionalProperties": false
}
