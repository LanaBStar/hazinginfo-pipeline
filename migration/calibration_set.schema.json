{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazinginfo.org/schemas/migration/calibration_set.schema.json",
  "title": "calibration_set.json",
  "description": "Volunteer calibration set, written by migration/export_legacy.py per IMPLEMENTATION_PLAN.md Section 13 item 2 / Section 9. Each entry points at a document export_legacy.py confirmed was already backfilled into the new archive (migration/backfill_manifests.py) by a previously human-verified legacy incident, plus that legacy incident's old fields kept as a reference answer-key. These fields are NOT published data -- they lack quotes/anchors and do not meet the new evidentiary standard (IMPLEMENTATION_PLAN.md Section 5) -- they exist only so a reviewer's independent re-extraction of doc_dir under the new schema can be compared against a known prior answer during calibration.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "calibration_set": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legacy_incident_id": {"type": "integer"},
          "unitid": {"type": "string"},
          "doc_dir": {"type": "string"},
          "legacy_fields": {
            "type": "object",
            "properties": {
              "location": {"type": ["string", "null"]},
              "incident_date_raw": {"type": ["string", "null"]},
              "incident_start_date": {"type": ["string", "null"], "format": "date"},
              "incident_end_date": {"type": ["string", "null"], "format": "date"},
              "date_reported": {"type": ["string", "null"], "format": "date"},
              "investigation_initiated_date": {"type": ["string", "null"], "format": "date"},
              "investigation_concluded_date": {"type": ["string", "null"], "format": "date"},
              "incident_description_raw": {"type": ["string", "null"]},
              "use_of_alcohol": {"type": ["boolean", "null"]},
              "use_of_drugs": {"type": ["boolean", "null"]},
              "outcome_raw": {"type": ["string", "null"]},
              "hazing_determination": {"type": ["boolean", "null"]},
              "is_aggravated": {"type": ["boolean", "null"]},
              "verified_by": {"type": "string"},
              "verified_at": {"type": "string", "format": "date-time"}
            },
            "required": [
              "location", "incident_date_raw", "incident_start_date", "incident_end_date",
              "date_reported", "investigation_initiated_date", "investigation_concluded_date",
              "incident_description_raw", "use_of_alcohol", "use_of_drugs", "outcome_raw",
              "hazing_determination", "is_aggravated", "verified_by", "verified_at"
            ],
            "additionalProperties": false
          }
        },
        "required": ["legacy_incident_id", "unitid", "doc_dir", "legacy_fields"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "calibration_set"],
  "additionalProperties": false
}
